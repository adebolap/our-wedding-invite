    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.11",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "oxlint": "^1.81.0",
